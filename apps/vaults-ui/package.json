{
  "name": "@rwally/vaults-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "React surface over apps/web's tested vault logic: vaults, proposals, votes, holdings.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint src",
    "typecheck": "tsc -b --force",
    "preview": "vite preview",
    "smoke": "vite build --ssr ssr-smoke.tsx --outDir dist-ssr && node dist-ssr/ssr-smoke.js"
  },
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "^5.0.0",
    "@fontsource/ibm-plex-mono": "^5.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "viem": "^2.57.18"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "oxlint": "^1.93.0",
    "typescript": "~5.9.0",
    "vite": "^7.3.8"
  }
}
